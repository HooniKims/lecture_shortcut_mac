{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cue",
  "version": "0.1.0",
  "identifier": "dev.cue.desktop",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cue",
        "width": 1160,
        "height": 780,
        "minWidth": 820,
        "minHeight": 620,
        "backgroundColor": "#191c21",
        "theme": "Dark"
      },
      {
        "label": "presenter",
        "title": "Cue · 발표자 패널",
        "url": "index.html?panel",
        "width": 360,
        "height": 520,
        "minWidth": 300,
        "minHeight": 260,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "backgroundColor": "#191c21",
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/cue-native"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
