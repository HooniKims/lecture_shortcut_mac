{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cue",
  "version": "0.2.0",
  "identifier": "dev.cue.desktop",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cue",
        "width": 1160,
        "height": 780,
        "minWidth": 820,
        "minHeight": 620,
        "backgroundColor": "#191c21",
        "theme": "Dark"
      },
      {
        "label": "presenter",
        "title": "Cue \u00b7 \ubc1c\ud45c\uc790 \ud328\ub110",
        "url": "index.html?panel",
        "width": 360,
        "height": 520,
        "minWidth": 300,
        "minHeight": 260,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "backgroundColor": "#191c21",
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/cue-native"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFRjZBNjA5NzJEOEE5MEQKUldRTnFkaHlDYWIyUHJpSDVta0FpTUVLRncyNUZ1cVVCTHg0dHdDcnBqQUo1NkwzRVhJR0xrelMK",
      "endpoints": [
        "https://github.com/HooniKims/lecture_shortcut_mac/releases/latest/download/latest.json"
      ]
    }
  }
}
